# Provider keys — prefer encrypted form (AES-256-GCM) for production.
# Generate master key: openssl rand -base64 32  (store as FUSION_MASTER_KEY, not in repo)
# Encrypt: use SecretManager::new(key).encrypt("sk-...")  → paste ciphertext below
# FUSION_MASTER_KEY=base64-32-bytes
# OPENROUTER_API_KEY_ENCRYPTED=<ciphertext>

# Plaintext / env-var indirection (dev only; use --unsafe-dev for placeholders)
OPENCODEZEN_API_KEY=sk-or-v1-your-key-here
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENCODEZEN_BASE_URL=https://api.opencode.ai/v1
# OPENROUTER_API_KEY_ENV=MY_SECRET_ENV_VAR
GROQ_API_KEY=gsk_placeholder-dev-only
